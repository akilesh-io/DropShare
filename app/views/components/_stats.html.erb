<div>
  <div class="stats-card">
    <div class="stat">
        <div class="value">
            <%= number_to_human(@stats.lifetime_uploads, units: { thousand: "K", million: "M", billion: "B" }) %>
        </div>
        <div class="label">Files Shared</div>
    </div>

    <div class="stat">
        <div class="value"><%= number_to_human_size(@stats.lifetime_size, precision: 2) %></div>
        <div class="label">Uploaded</div>
    </div>

    <div class="stat">
      <div class="value"><%= @stats.estimated_co2_kg %> kg CO₂</div>
      <div class="label">Emitted</div>
    </div>
  </div>
</div>
