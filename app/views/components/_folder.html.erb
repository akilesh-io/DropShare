<div class="folder" data-folder-id="<%= koppurai.id %>">
  <div class="folder-title">
    <div class="folder-meta">
      <div>Expires in <%= time_ago_in_words(koppurai.expires_at) %></div>
      <span>&#x2022;</span>
      <div><%= pluralize(koppurai.koppus.size, "file") %></div>
      <span>&#x2022;</span>
      <div><%= number_to_human_size(koppurai.total_size) %></div>
      <% if local_assigns[:is_owner] %>
      <span>&#x2022;</span>
        <div>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" class="feather feather-download">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <%= koppurai.downloads_count %>
        </div>
      <% end %>
    </div>

    <div class="folder-actions">
      <div class="folder-link">
        <input value="<%= share_url(koppurai.share_key) %>" readonly />
        <button class=" btn-primary copy-btn icon-btn" data-link="<%= share_url(koppurai.share_key) %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" > <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/> <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </button>
      </div>

      <button type="button" class="icon-btn" popovertarget="qr-<%= koppurai.id %>" title="Show QR code" aria-label="Show QR code">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3z"/><path d="M21 14v3M14 21h3M20 20h1"/></svg>
      </button>

      <div id="qr-<%= koppurai.id %>" class="qr-popover" popover>
        <% qr = RQRCode::QRCode.new(share_url(koppurai.share_key)) %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 <%= qr.qrcode.module_count + 8 %> <%= qr.qrcode.module_count + 8 %>"
             role="img" aria-label="QR code for <%= share_url(koppurai.share_key) %>" shape-rendering="crispEdges">
          <%= raw qr.as_svg(module_size: 1, offset: 4, use_path: true, standalone: false, color: "0e1012", fill: "ffffff") %>
        </svg>
      </div>
      <% if local_assigns[:is_owner] %>
        <%= button_to destroy_koppurai_drop_path(koppurai), method: :delete, class: "icon-btn",
                form: { data: { turbo_confirm: "Delete this folder?" } } do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash-2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
        <% end %>
      <% else %>
        <%= link_to download_folder_path(share_key: koppurai.share_key), class: "icon-btn download-all-btn", data: { turbo: false } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="M7 10L12 15 17 10"></path><path d="M12 15L12 3"></path></g></svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="file-group" id="folder-<%= koppurai.id %>-files">
    <% koppurai.koppus.each do |koppu| %>
      <%= render "/components/file_item", koppu: koppu, is_owner: is_owner %>
    <% end %>

    <% if local_assigns[:is_owner] %>
      <input type="file" multiple class="koppu-input" id="koppu-input-<%= koppurai.id %>" data-koppurai-id="<%= koppurai.id %>" style="display:none" />
      <button type="button" class="file add-file-btn" data-koppurai-id="<%= koppurai.id %>">
        <div class="add-file">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
      </button>
    <% end %>
  </div>
</div>

