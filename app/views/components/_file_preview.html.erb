<% if koppu.koppu.attached? %>
  <% if koppu.koppu.video? %>
    <video controls muted playsinline preload="metadata" class="video-preview">
      <source src="<%= url_for(koppu.koppu) %>" type="<%= koppu.koppu.content_type %>">
    </video>

  <% elsif koppu.koppu.representable? %>
    <!-- todo: for addmin show loq quality for user show high quilty -->
    <%#= image_tag koppu.koppu.representation(resize_to_limit: [200, 200]) %>
    <%= image_tag koppu.koppu.representation(resize_to_limit: [1200, 1200], saver: { quality: 95 }) %>

  <% elsif koppu.koppu.audio? %>
    <!-- <audio controls preload="metadata" class="audio-preview"> -->
    <!--   <source src="<%= url_for(koppu.koppu) %>" type="<%= koppu.koppu.content_type %>"> -->
    <!--   Your browser does not support the audio element. -->
    <!-- </audio> -->
<div class="audio-player" data-audio-player>
  <audio preload="metadata">
    <source src="<%= url_for(koppu.koppu) %>" type="<%= koppu.koppu.content_type %>">
  </audio>

  <svg class="audio-wheel" viewBox="0 0 120 120">
    <circle class="wheel-bg" cx="60" cy="60" r="48" />
    <circle class="wheel-progress" cx="60" cy="60" r="48" />
  </svg>

  <button class="audio-btn">▶</button>
  <div class="audio-time">0:00</div>
</div>
  <% elsif koppu.koppu.blob.content_type == "application/pdf" %>
    <iframe src="<%= url_for(koppu.koppu) %>" width="250" height="300"></iframe>

  <% else %>
    <div class="no-preview">
      <%= link_to rails_blob_path(koppu.koppu, disposition: "attachment") do %>
        <%= image_tag attachment_icon(koppu.koppu.blob) , alt: "Download file" %>
      <% end %>
    </div>
  <% end %>
<% end %>

