<h3 class="heading-xs">Share Files</h3>

<% @koppurai.each do |koppurai| %>
  <div class="folder" data-folder-id="<%= koppurai.id %>"> 
    <div class="folder-title">
      <input value="<%= share_url(koppurai.share_key) %>" readonly />
      <button class="btn btn-primary copy-btn" data-link="<%= share_url(koppurai.share_key) %>">
        Copy
      </button>
      
      <%= button_to destroy_koppurai_drop_path(koppurai), method: :delete, class: "icon-btn",
              form: { data: { turbo_confirm: "Delete this folder?" } } do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash-2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
      <% end %>
    </div>

    <div class="file-group">
      <% koppurai.koppus.each do |koppu| %>
        <div class="file" title="<%= koppu.koppu.filename %>" data-file-id="<%= koppu.id %>">
          <%= button_to destroy_koppu_drop_path(koppu), method: :delete, class: "icon-btn",
              form: { data: { turbo_confirm: "Delete this file?" } } do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash-2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          <% end %>
          <div class="file-preview">
            <%= render "/components/file_preview", koppu: koppu %>
          </div>

          <p class="text-xs"><%= truncate(koppu.koppu.filename.to_s, length: 28) %></p>
          <p class="text-xs">Downloads: <%= koppu.downloads_count %></p>
          <p class="text-xs"><%= number_to_human_size(koppu.byte_size) %></p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>


<div class="footer-love">
  Crafted With 💙 by <%= link_to "Akilesh", "https://akilesh.in", target: "_blank" %>
</div>
