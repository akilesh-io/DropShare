<div class="dropzone" data-dropzone>
  <p class="drop-title">DROP</p>
  <p class="drop-sub">or click to upload</p>
</div>

<%#= form_with(model: @koppukal, url: drop_index_path, method: :post, multipart: true) do |form| %>
<%= form_with(url: drop_index_path, method: :post, multipart: true) do |form| %>
   <%= form.file_field :koppu, multiple: true, direct_upload: true, hidden: true %>
   <%= form.submit "Upload", hidden: true %>
<% end %>

