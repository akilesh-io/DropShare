<h1>Share</h1>
<% @uploads.each do |u| %>
  <div title="<%= u.file.filename %>">
    <!-- <input value="<%= share_url(u.token) %>" readonly /> -->
    <%= button_to download_path(token: u.token), method: :get, target: "_blank", class: "btn btn-light", data: { turbo: false } do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-share-2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
    <% end %>
    <%= button_to download_path(token: u.token), method: :get, target: "_blank", class: "btn btn-light", data: { turbo: false } do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="M7 10L12 15 17 10"></path><path d="M12 15L12 3"></path></g></svg>
    <% end %>

    <%= render "/components/file_preview", upload: u %>
  </div>
<% end %>

