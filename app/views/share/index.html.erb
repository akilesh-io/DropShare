<div class="share-page">

  <div class="share-header">
    <h1 class="share-title">
      <%= @koppurai.title || "Shared Files" %>
    </h1>

    <input
      class="share-link"
      value="<%= share_url(@koppurai.share_key) %>"
      readonly>
  </div>

  <div class="koppukal-grid">

    <% @koppukal.each do |koppu| %>

      <div
        class="koppu-card"
        title="<%= koppu.koppu.filename %>">

        <div class="preview-wrapper">
          <%= render "/components/file_preview",
              koppu: koppu %>
        </div>

        <div class="koppu-footer">

          <div class="koppu-meta">
            <p class="koppu-name">
              <%= truncate(
                    koppu.koppu.filename.to_s,
                    length: 24
                  ) %>
            </p>

            <p class="koppu-size">
              <%= number_to_human_size(
                    koppu.byte_size
                  ) %>
            </p>
          </div>

          <%= button_to download_koppu_path(
                share_key: koppu.share_key
              ),
              method: :get,
              target: "_blank",
              class: "download-btn",
              data: { turbo: false } do %>

            <svg xmlns="http://www.w3.org/2000/svg"
                 width="18"
                 height="18"
                 viewBox="0 0 24 24">
              <g stroke-linejoin="round"
                 stroke-linecap="round"
                 stroke-width="2"
                 fill="none"
                 stroke="currentColor">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <path d="M7 10L12 15 17 10"></path>
                <path d="M12 15L12 3"></path>
              </g>
            </svg>

          <% end %>

        </div>

      </div>

    <% end %>

  </div>

</div>
