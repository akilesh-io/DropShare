<!-- remove this duplicate component mode the _folder partial to component  -->

<div class="folder" data-folder-id="<%= koppurai.id %>" data-download-urls="<%= koppurai.koppus.map { |k| rails_blob_path(k.koppu, disposition: "attachment") }.to_json %>">
  <div class="folder-title">
    <div class="folder-meta">
      <div>Expires in <%= time_ago_in_words(koppurai.expires_at) %></div>
      <span>&#x2022;</span>
      <div><%= number_to_human_size(koppurai.total_size) %></div>
    </div>

    <div class="folder-actions">
      <div class="folder-link">
        <input value="<%= share_url(koppurai.share_key) %>" readonly />
        <button class=" btn-primary copy-btn" data-link="<%= share_url(koppurai.share_key) %>">
          Copy
        </button>
      </div>
      <%#= button_to download_koppurai_path(share_key: koppurai.share_key), 
        method: :get, target: "_blank", class: "icon-btn download-all-btn", 
        data: { turbo: false, link: share_url(koppurai.share_key) } do %>
      <button type="button" class="icon-btn download-all-btn">
         <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="M7 10L12 15 17 10"></path><path d="M12 15L12 3"></path></g></svg>
      </button>
    </div>
  </div>

  <div class="file-group" id="folder-<%= koppurai.id %>-files">
    <% koppurai.koppus.each do |koppu| %>
      <%= render "/components/file_item", koppu: koppu, is_admin: false %>
    <% end %>
  </div>
</div>


<script>
document.addEventListener("click", (e) => {
  const btn = e.target.closest(".download-all-btn")
  if (!btn) return

  const folder = btn.closest(".folder")
  const urls = JSON.parse(folder.dataset.downloadUrls)

  urls.forEach((url, index) => {
    setTimeout(() => {
      const a = document.createElement("a")
      a.href = url
      a.download = ""
      document.body.appendChild(a)
      a.click()
      a.remove()
    }, index * 250)
  })
})
</script>
